# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# Secret for encrypting tokens in transit and signing sessions (minimum 32 characters)
SESSION_SECRET=super-secret-random-key-at-least-32-chars-long-youtube-roast

# Optional: Next.js public site URL for share card absolute URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
